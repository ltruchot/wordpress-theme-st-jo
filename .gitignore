# Ignore dependencies from npm and Composer:
/node_modules
/vendor

# Ignore generated JavaScript files:
*.min.js

# Ignore generated CSS files:
style.css
style-editor.css
style-editor-extra.css

# Ignore the generated zip file:
st-jo.zip

# Ignore .DS_Store files from macOS:
.DS_Store
# Claude Code settings are machine-specific; the skills are shared with the team:
.claude/*
!.claude/skills/
.claude/settings.local.json

# Windows crash artifact, unrelated to the theme:
debug.log

# Photos dropped here before processing. This repository is public: a photo of
# pupils must never enter it, not even for the length of one commit.
#
# Anchored to the root: this is the one drop zone. Without the leading slash the
# pattern would also swallow any other directory named "raw", at any depth, and
# hiding files nobody asked to hide is how a rule stops being trusted.
/raw/
